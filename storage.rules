rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function hasAnyRole(roles) {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    // Anexos do projeto: documentos, referências de preço (IN 65/2021),
    // comprovantes, relatórios. O app usa nomes em português (documentos,
    // referencias_precos) — este catch-all cobre todas as subpastas.
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Comprovantes/anexos da execução mensal (notas, recibos por competência).
    match /execucao/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Logos e documentos de fornecedores.
    match /suppliers/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Logos de patrocinadores/parceiros.
    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'coordenador']);
    }

    // Logos e Documentos de Entidades
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /entities/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default: bloqueia o resto, só admin.
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }
  }
}
