# === Ambiente: HOMOLOGAÇÃO / DEV ===
# Carregado pelo Vite no "npm run dev" e "npm run build:homolog".
# Copie para .env.development e preencha com os valores do projeto de staging
# (quando existir; enquanto não houver, pode apontar para lie-projetos mesmo).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_ENV=staging
