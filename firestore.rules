rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && getUserData().role in roles;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- USUÁRIOS ---
    // Perfis: admin, coordenador, captador, financeiro, beneficiado, leitor
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // --- PROJETOS ---
    // Documento principal de um projeto LIE (nº PRONAS/PROESPI, valor aprovado,
    // patrocinadores, status, datas-chave).
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Flexibilizado para testes
      allow update: if hasAnyRole(['admin', 'coordenador', 'captador', 'financeiro']);
      allow delete: if hasRole('admin');

      // --- Subcoleções do projeto ---

      // Itens do projeto (vinculados ao banco de itens master).
      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if hasAnyRole(['admin', 'coordenador']);
      }

      // Cronograma físico-financeiro (metas/etapas/atividades).
      match /cronograma/{itemId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if hasAnyRole(['admin', 'coordenador']);
      }

      // Execução mensal (lançamentos físico-financeiros por competência).
      match /execucao/{execId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if hasAnyRole(['admin', 'coordenador', 'financeiro']);
      }

      // Documentos do projeto (planos, aprovações, ofícios, comprovantes).
      match /documentos/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if hasAnyRole(['admin', 'coordenador']);
      }

      // Referências de preço (pesquisa automática IN 65/2021).
      match /referencias_precos/{refId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if hasAnyRole(['admin', 'coordenador']);
      }

      // Catch-all das demais subcoleções do projeto (segurança/extensibilidade).
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // --- Logs de auditoria ---
    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if hasRole('admin');
      allow update, delete: if false;
    }

    // --- Configurações de sistema ---
    match /system_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    // --- VALIDAÇÃO PÚBLICA DE COTAÇÕES (IN 65/2021) ---
    match /cotacoesValidadoras/{token} {
      allow read: if true; // Acesso público para auditoria
      allow create, update: if isAuthenticated();
      allow delete: if hasRole('admin');
    }

    // --- ENTIDADES ---
    match /entities/{entityId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['admin', 'coordenador', 'captador']);
      allow delete: if hasRole('admin');

      match /documentos/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['admin', 'coordenador', 'captador']);
      }
      match /dirigentes/{dirId} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['admin', 'coordenador', 'captador']);
      }
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if hasAnyRole(['admin', 'coordenador', 'captador']);
      }
    }

    // --- BANCO DE ITENS (master) ---
    // Itens base reutilizados nos projetos (nome, categoria, unidade, CATMAT/CATSER).
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if hasAnyRole(['admin', 'coordenador']);
    }

    // --- FORNECEDORES ---
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if hasAnyRole(['admin', 'coordenador']);

      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // --- CATÁLOGO CATMAT/CATSER (cache CNBS, sincronizado pelas Functions) ---
    match /catalogo_pdms/{pdmId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /catalogo_servicos/{servicoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- MODALIDADES ESPORTIVAS ---
    match /modalidades/{modalidadeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if hasAnyRole(['admin', 'coordenador']);
    }

    // --- Default: bloqueia tudo o resto exceto admin ---
    match /{document=**} {
      allow read, write: if hasRole('admin');
    }
  }
}
